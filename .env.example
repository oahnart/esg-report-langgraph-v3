# Team RAG service
TEAM_RAG_BASE_URL=http://192.168.1.11:8787
TEAM_RAG_QUALITATIVE_PATH=/qualitative/evidence/v3
TEAM_RAG_TIMEOUT_SECONDS=30
TEAM_RAG_TOP_K=5
ESG_TEAM_RAG_RETRY_TOP_K=0
TEAM_RAG_BATCH_SIZE=20
TEAM_RAG_MAX_RETRIES=2
TEAM_RAG_CONCURRENCY=4

# Project paths
ESG_TEMPLATE_DIR=template_v1
ESG_OUTPUT_DIR=data/outputs
ESG_CACHE_DIR=data/cache

# Temporal job orchestration
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=esg-report
TEMPORAL_API_KEY=
TEMPORAL_TLS=false
TEMPORAL_ACTIVITY_TIMEOUT_SECONDS=3600
TEMPORAL_WORKFLOW_TIMEOUT_SECONDS=7200
TEMPORAL_HEARTBEAT_TIMEOUT_SECONDS=180
TEMPORAL_ACTIVITY_MAX_ATTEMPTS=2
TEMPORAL_WORKER_MAX_CONCURRENT_ACTIVITIES=2

# Quantitative input: file (default) or api
ESG_QUANTITATIVE_INPUT_MODE=file
ESG_QUANTITATIVE_INPUT_DIR=data/inputs
ESG_QUANTITATIVE_API_BASE_URL=
ESG_QUANTITATIVE_API_PATH=/companies/{company_id}/{year}/quantitative
ESG_QUANTITATIVE_API_KEY=
ESG_QUANTITATIVE_API_TIMEOUT_SECONDS=30
ESG_METRIC_QID_BRIDGE_ENABLED=true
ESG_OUTPUT_TIMEZONE=Asia/Bangkok

# LLM provider: openai or hallmdr
OPENAI_API_KEY=
ESG_LLM_API_KEY=
HALLMDR_API_KEY=
ESG_LLM_PROVIDER=openai
ESG_LLM_BASE_URL=https://api.openai.com/v1
ESG_LLM_USER_AGENT=Mozilla/5.0
ESG_LLM_TIMEOUT_SECONDS=120
ESG_QUICK_THINK_LLM=gpt-4.1-mini
ESG_DEEP_THINK_LLM=gpt-4.1
ESG_OPENAI_REASONING_EFFORT=
ESG_AGENT_MODE=auto
ESG_MAX_REVISION_ROUNDS=2
ESG_MAX_RECUR_LIMIT=100
ESG_OUTPUT_LANGUAGE=Korean

# HallMDR/H200 example (replace the provider, URL and models above):
# ESG_LLM_PROVIDER=hallmdr
# ESG_LLM_BASE_URL=https://api.hallmdr.com
# HALLMDR_API_KEY=your-hallmdr-key
# ESG_QUICK_THINK_LLM=llm/gemma4
# ESG_DEEP_THINK_LLM=llm/gemma4

# Runtime behavior
ESG_CHECKPOINT_ENABLED=false
ESG_ACCEPTED_ANSWER_STATUSES=high_confidence,medium_confidence,sufficient,confident
ESG_CONDITIONAL_ANSWER_STATUSES=thin_but_usable
ESG_REJECTED_SEMANTIC_LABELS=weak,irrelevant,no_match
ESG_SEMANTIC_QA_ENABLED=true
ESG_SEMANTIC_QA_CONCURRENCY=4
ESG_SOURCE_POLICY_ENABLED=true
ESG_OUTPUT_HYGIENE_ENABLED=true
