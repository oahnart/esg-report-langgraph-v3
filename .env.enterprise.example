# Enterprise deployment overrides
TEAM_RAG_BASE_URL=https://your-rag-service.example.com
TEAM_RAG_TIMEOUT_SECONDS=60
TEAM_RAG_MAX_RETRIES=3
TEMPORAL_ADDRESS=your-namespace.tmprl.cloud:7233
TEMPORAL_NAMESPACE=your-namespace.account
TEMPORAL_TASK_QUEUE=esg-report
TEMPORAL_API_KEY=
TEMPORAL_TLS=true
ESG_QUANTITATIVE_INPUT_MODE=api
ESG_QUANTITATIVE_API_BASE_URL=https://your-company-data-service.example.com
ESG_QUANTITATIVE_API_PATH=/companies/{company_id}/{year}/quantitative
ESG_QUANTITATIVE_API_TIMEOUT_SECONDS=60
ESG_OUTPUT_TIMEZONE=Asia/Bangkok

# Keep real secrets in .env.enterprise, not in this example file.
